{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "app/main.py"
        }
    },
    "rewrites": [
        {
            "source": "/api/v1/(.*)",
            "destination": {
                "type": "service",
                "service": "backend",
                "path": "/api/v1/$1"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend",
                "path": "/$1"
            }
        }
    ]
}
