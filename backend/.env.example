# Database (Supabase PostgreSQL Connection String or Local SQLite)
# Example Supabase: postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
# For local zero-setup dev, default to sqlite:
DATABASE_URL=sqlite+aiosqlite:///./accounting.db

# AI Provider Configuration (supported: gemini, openai, anthropic)
AI_PROVIDER=gemini

# API Keys (set at least one depending on AI_PROVIDER)
# You can provide multiple comma-separated keys for automatic fallback on rate limit/quota reached
GEMINI_API_KEY=your_google_gemini_api_key_here,another_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App Settings
APP_NAME="Cyber Nuts AI Accounting Assistant"
DEBUG=True
API_V1_STR=/api/v1
